
{
  "app": {
    "name": "India Flight Intelligence",
    "environment": "development",
    "log_level": "INFO",
    "timezone": "Asia/Kolkata"
  },
  "collection": {
    "enabled": false,
    "request_timeout_seconds": 20,
    "max_retries": 3,
    "publish_raw_data": false
  },
  "adsb": {
    "provider": "adsb.lol",
    "base_url": "https://api.adsb.lol",
    "enabled": false,
    "pilot_mode": true,
    "max_requests_per_run": 2,
    "max_payload_mb_per_run": 5,
    "request_timeout_seconds": 20,
    "max_retries": 2,
    "retry_backoff_seconds": 2,
    "publish_raw_data": false
  },
  "storage": {
    "backend": "local",
    "database_url_env_var": "DATABASE_URL"
  },
  "public_api": {
    "enabled": false,
    "serve_only_approved_aggregates": true
  },
  "limits": {
    "max_requests_per_run": 10,
    "max_payload_mb_per_run": 25,
    "stop_on_quota_warning": true
  }
}
